# Library service (src/lragents/service/app.py)
LRAGENTS_BACKEND=memory            # memory | gcp
GOOGLE_CLOUD_PROJECT=my-project
GOOGLE_CLOUD_LOCATION=asia-southeast1
GEMINI_MODEL=gemini-3.8-flash
TASKS_QUEUE=agent-steps
SERVICE_URL=https://lragents-xxxx-as.a.run.app
TASKS_INVOKER_SA=sa-tasks-invoker@my-project.iam.gserviceaccount.com
PUBSUB_INVOKER_SA=sa-tasks-invoker@my-project.iam.gserviceaccount.com
PRICE_IN_PER_M=0.5                 # $/M input tokens for cost budgets
PRICE_OUT_PER_M=3.0
APPROVAL_TTL_S=259200              # 72h

# ADK service (src/lragents/adk/main.py)
GOOGLE_GENAI_USE_VERTEXAI=1
SESSION_SERVICE_URI=sqlite+aiosqlite:///sessions.db   # prod: postgresql+asyncpg://user:pw@/adk?host=/cloudsql/PROJ:REGION:INST
ARTIFACT_SERVICE_URI=              # gs://bucket/artifacts
STAGING_BUCKET=gs://my-staging     # Agent Runtime deploy
