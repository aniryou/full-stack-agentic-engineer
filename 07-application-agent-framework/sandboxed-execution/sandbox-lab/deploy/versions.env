# Pinned versions for every deploy script in this lab (checked 2026-09-26; verify before bumping).
# kind and its node image are the ones layer 03's k8s-gpu-lab pins (Kubernetes 1.34).
KIND_VERSION=v0.33.0
KIND_NODE_IMAGE=kindest/node:v1.34.11@sha256:44e222ee2132dab25ff87301682f89eb82c7880ea3a1bf543bfe9708fd08d67d
# The sandbox, proxy and stub all run python:3.12-slim (standard library only); pin a digest in production.
SANDBOX_IMAGE=python:3.12-slim
PROBE_IMAGE=busybox:1.38.0
# kubernetes-sigs/agent-sandbox release for the optional warm-pool CRDs on GKE (verify).
AGENT_SANDBOX_VERSION=v1.0.2
