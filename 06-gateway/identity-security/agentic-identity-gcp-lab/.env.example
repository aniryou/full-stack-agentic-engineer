# Copy to .env and export (e.g. `set -a; source .env; set +a`). All optional in the local profile.
AGENTSEC_PROFILE=local            # local | gcp
AGENTSEC_PROJECT_ID=demo-project
AGENTSEC_PROJECT_NUMBER=987654321098
AGENTSEC_ORG_ID=123456789012      # leave empty for a project without an organisation
AGENTSEC_LOCATION=us-central1
AGENTSEC_AGENT_ENGINE_ID=support-agent
AGENTSEC_MODEL=gemini-2.5-flash   # used in the gcp profile; the local profile uses the scripted model
AGENTSEC_POLICY=policies/support-agent.yaml
AGENTSEC_MCP_URL=http://127.0.0.1:8765/mcp
AGENTSEC_STS_ISSUER=https://sts.agentsec.local
AGENTSEC_AUTH_PROVIDER=tickets-3lo
AGENTSEC_MODEL_ARMOR_TEMPLATE=    # projects/P/locations/L/templates/T (gcp profile)
AGENTSEC_AUDIT_LOG=agentsec-audit
